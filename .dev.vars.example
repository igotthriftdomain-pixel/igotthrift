# Local development secrets for Cloudflare Wrangler (Copy to .dev.vars for local testing)

# Secret key used for signing HTTP-only auth cookies (Must be at least 32 characters long)
SESSION_SECRET=replace_with_a_secure_random_secret_string_32chars_min

# R2 Public URL override for local development if testing local asset serving
NEXT_PUBLIC_R2_PUBLIC_URL=http://localhost:8787/media
